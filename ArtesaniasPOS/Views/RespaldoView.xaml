<UserControl x:Class="ArtesaniasPOS.UI.Views.Configuracion.RespaldoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <!-- Aviso -->
            <Border Background="#f7efdf" CornerRadius="12" BorderBrush="#e6d3a8" BorderThickness="1"
                    Padding="18,15" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🛡️" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Tus datos están protegidos automáticamente"
                                   FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="#7a5a17"/>
                        <TextBlock TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12.5"
                                   Foreground="#6b5520" Margin="0,3,0,0"
                                   Text="La aplicación crea una copia de seguridad sola: tras cada venta y al cerrar el programa. Aun así, guarda de vez en cuando una copia manual en una memoria USB o en la nube."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ubicación de la base de datos -->
            <Border Background="White" CornerRadius="14" BorderBrush="#ddc0b8" BorderThickness="1"
                    Padding="22,18" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#56423c" Opacity="0.07" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Ubicación de la base de datos"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#1b1c1b"
                               Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Carpeta" FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding RutaBaseDatos}" FontFamily="Consolas" FontSize="11.5"
                                   Foreground="#56423c" TextWrapping="Wrap" HorizontalAlignment="Right"
                                   TextAlignment="Right" Margin="100,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Tamaño" FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b"/>
                        <TextBlock Text="{Binding Tamano}" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#56423c" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button Style="{StaticResource ButtonGhost}" Padding="16,9" HorizontalAlignment="Left"
                            Click="BtnCambiarUbicacion_Click">
                        <TextBlock Text="📁  Cambiar ubicación" Foreground="#9d3d1c" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Respaldo automático -->
            <Border Background="White" CornerRadius="14" BorderBrush="#ddc0b8" BorderThickness="1"
                    Padding="22,18" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#56423c" Opacity="0.07" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Respaldo automático" FontFamily="Segoe UI" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#1b1c1b" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Carpeta" FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding CarpetaRespaldos}" FontFamily="Consolas" FontSize="11.5"
                                   Foreground="#56423c" TextWrapping="Wrap" HorizontalAlignment="Right"
                                   TextAlignment="Right" Margin="100,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Último respaldo" FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b"/>
                        <TextBlock Text="{Binding UltimoRespaldoTexto}" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#3f6b4f" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button Style="{StaticResource ButtonGhost}" Padding="16,9" HorizontalAlignment="Left"
                            Click="BtnCambiarCarpetaRespaldos_Click">
                        <TextBlock Text="📂  Cambiar carpeta de respaldos" Foreground="#9d3d1c" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Acciones manuales -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Crear copia -->
                <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#ddc0b8"
                        BorderThickness="1" Padding="22,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#56423c" Opacity="0.07" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#e6f0e9" CornerRadius="11" Width="46" Height="46" HorizontalAlignment="Left">
                            <TextBlock Text="💾" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Crear copia de seguridad" FontFamily="Segoe UI" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#1b1c1b" Margin="0,12,0,3"/>
                        <TextBlock TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b"
                                   Text="Guarda una copia de toda tu información en la carpeta que elijas."
                                   Margin="0,0,0,14"/>
                        <Button Style="{StaticResource ButtonPrimary}" Padding="18,10"
                                HorizontalAlignment="Left" Click="BtnRespaldar_Click">
                            <TextBlock Text="Crear copia" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Restaurar -->
                <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#ddc0b8"
                        BorderThickness="1" Padding="22,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#56423c" Opacity="0.07" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#f7e8e1" CornerRadius="11" Width="46" Height="46" HorizontalAlignment="Left">
                            <TextBlock Text="♻️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Restaurar desde una copia" FontFamily="Segoe UI" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#1b1c1b" Margin="0,12,0,3"/>
                        <TextBlock TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b"
                                   Text="Reemplaza los datos actuales con los de una copia de seguridad."
                                   Margin="0,0,0,14"/>
                        <Button Style="{StaticResource ButtonGhost}" Padding="18,10"
                                HorizontalAlignment="Left" Click="BtnRestaurar_Click">
                            <TextBlock Text="Restaurar" VerticalAlignment="Center" Foreground="#9d3d1c" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mensaje de resultado -->
            <Border CornerRadius="10" Padding="14,11"
                    Visibility="{Binding Mensaje, Converter={StaticResource StringToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#e6f0e9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsError}" Value="True">
                                <Setter Property="Background" Value="#fdecea"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensaje}" FontFamily="Segoe UI" FontSize="12.5" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#3f6b4f"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsError}" Value="True">
                                    <Setter Property="Foreground" Value="#ba1a1a"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
