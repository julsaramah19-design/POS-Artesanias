<UserControl x:Class="ArtesaniasPOS.UI.Views.Productos.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#fbf9f7">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANEL: PRODUCT LIST ==================== -->
        <Grid Grid.Column="0" Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Productos"
                               FontFamily="Palatino Linotype"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1b1c1b"/>
                    <TextBlock Text="Gestiona el catálogo de tu negocio"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#8a726b"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- New product button (admin only) -->
                <Button Grid.Column="1"
                        Command="{Binding NuevoCommand}"
                        Cursor="Hand"
                        Padding="18,11"
                        Visibility="{Binding PuedeEditar,
                            Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="White"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo producto"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Search & filter bar -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search TextBox -->
                <TextBox Grid.Column="0"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         Foreground="#1b1c1b"
                         Background="#f5f3f1"
                         BorderBrush="#ddc0b8"
                         BorderThickness="1.5"
                         Padding="14,10">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="PSBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"/>
                                                <TextBlock Text="&#x1F50D;  Buscar por nombre o código..."
                                                           FontFamily="Segoe UI"
                                                           FontSize="13"
                                                           Foreground="#8a726b"
                                                           Margin="16,10,0,0"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent},
                                                               Converter={StaticResource StringToVisibilityInvertedConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="PSBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                <Setter TargetName="PSBorder" Property="Background" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding BuscarCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Category filter -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Categorias}"
                          SelectedItem="{Binding CategoriaFiltro}"
                          DisplayMemberPath="Nombre"
                          Padding="12,10"
                          FontFamily="Segoe UI"
                          FontSize="13">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Background"      Value="#f5f3f1"/>
                            <Setter Property="BorderBrush"     Value="#ddc0b8"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <!-- Search button -->
                <Button Grid.Column="4"
                        Command="{Binding BuscarCommand}"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SearchBorder"
                                                Background="White"
                                                BorderBrush="#ddc0b8"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                Padding="16,10">
                                            <TextBlock Text="Buscar"
                                                       FontFamily="Segoe UI"
                                                       FontSize="13"
                                                       Foreground="#56423c"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SearchBorder" Property="Background" Value="#f5f3f1"/>
                                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- DataGrid card -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#ddc0b8"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#56423c" Opacity="0.06" BlurRadius="12" ShadowDepth="1" Direction="270"/>
                </Border.Effect>

                <DataGrid ItemsSource="{Binding Productos}"
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#efedec"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#fbf9f7"
                          FontSize="13"
                          FontFamily="Segoe UI"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#f5f3f1"/>
                            <Setter Property="Foreground"      Value="#56423c"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="FontSize"        Value="12"/>
                            <Setter Property="FontFamily"      Value="Segoe UI"/>
                            <Setter Property="Padding"         Value="14,11"/>
                            <Setter Property="BorderBrush"     Value="#efedec"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding"         Value="14,9"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground"      Value="#1b1c1b"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#fdf0ec"/>
                                    <Setter Property="Foreground" Value="#9d3d1c"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- Barcode -->
                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding CodigoBarras}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize"   Value="12"/>
                                    <Setter Property="Foreground" Value="#8a726b"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Product name with avatar -->
                        <DataGridTemplateColumn Header="Nombre" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Border Width="30" Height="30"
                                                CornerRadius="15"
                                                Background="#fdf0ec"
                                                BorderBrush="#ddc0b8"
                                                BorderThickness="1"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F4E6;"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1b1c1b"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Category chip -->
                        <DataGridTemplateColumn Header="Categoría" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#efedec"
                                            CornerRadius="10"
                                            Padding="10,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CategoriaNombre}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#56423c"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Price -->
                        <DataGridTextColumn Header="Precio"
                                            Binding="{Binding PrecioBase, StringFormat='{}{0:N0}'}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily"   Value="Segoe UI"/>
                                    <Setter Property="FontWeight"   Value="SemiBold"/>
                                    <Setter Property="Foreground"   Value="#9d3d1c"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Stock indicator with colored dot -->
                        <DataGridTemplateColumn Header="Stock" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Status dot -->
                                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2d7a4f"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                            <Setter Property="Background" Value="#ba1a1a"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding StockActual}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2d7a4f"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                            <Setter Property="Foreground" Value="#ba1a1a"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action buttons (admin only) -->
                        <DataGridTemplateColumn Header="" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.PuedeEditar,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- Edit button -->
                                        <Button Command="{Binding DataContext.EditarCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Cursor="Hand"
                                                Margin="0,0,5,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="EditBorder"
                                                                        Background="#fdf0ec"
                                                                        BorderBrush="#ddc0b8"
                                                                        BorderThickness="1"
                                                                        CornerRadius="7"
                                                                        Padding="9,5">
                                                                    <TextBlock Text="&#xE70F;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="11"
                                                                               Foreground="#9d3d1c"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="EditBorder" Property="Background" Value="#9d3d1c"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Delete button -->
                                        <Button Command="{Binding DataContext.EliminarCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Cursor="Hand"
                                                Margin="0,0,5,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="DelBorder"
                                                                        Background="#ffdad6"
                                                                        BorderBrush="#f0b4ae"
                                                                        BorderThickness="1"
                                                                        CornerRadius="7"
                                                                        Padding="9,5">
                                                                    <TextBlock Text="&#xE74D;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="11"
                                                                               Foreground="#ba1a1a"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="DelBorder" Property="Background" Value="#ba1a1a"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Print label button -->
                                        <Button Command="{Binding DataContext.ImprimirEtiquetaCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="PrintBorder"
                                                                        Background="#e8f5e8"
                                                                        BorderBrush="#a8d8a8"
                                                                        BorderThickness="1"
                                                                        CornerRadius="7"
                                                                        Padding="9,5">
                                                                    <TextBlock Text="&#xE749;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="11"
                                                                               Foreground="#2d7a4f"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="PrintBorder" Property="Background" Value="#2d7a4f"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Error message -->
            <Border Grid.Row="3"
                    Background="#ffdad6"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,10,0,0"
                    Visibility="{Binding MensajeError,
                        Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x26A0;"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="#ba1a1a"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MensajeError}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#ba1a1a"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== RIGHT PANEL: FORM ==================== -->
        <Border Grid.Column="1"
                Width="368"
                Background="White"
                BorderBrush="#ddc0b8"
                BorderThickness="1,0,0,0"
                Visibility="{Binding PanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid DataContext="{Binding FormularioVm}" Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Form header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding TituloFormulario}"
                                   FontFamily="Palatino Linotype"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1b1c1b"/>
                        <Border Height="2" Background="#9d3d1c" Width="40"
                                HorizontalAlignment="Left" CornerRadius="1"
                                Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding CancelarCommand}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBorder"
                                                    Background="#efedec"
                                                    CornerRadius="7"
                                                    Padding="9,5">
                                                <TextBlock Text="&#xE711;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="#56423c"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBorder" Property="Background" Value="#ddc0b8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Scrollable form fields -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Categoría -->
                        <TextBlock Text="Categoría *"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#56423c"
                                   Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Categorias}"
                                  SelectedItem="{Binding CategoriaSeleccionada}"
                                  DisplayMemberPath="Nombre"
                                  Padding="12,9"
                                  FontFamily="Segoe UI"
                                  FontSize="13"
                                  Margin="0,0,0,14">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background"      Value="#f5f3f1"/>
                                    <Setter Property="BorderBrush"     Value="#ddc0b8"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- Código de barras -->
                        <TextBlock Text="Código de barras *"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#56423c"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,9"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 MaxLength="30"
                                 Margin="0,0,0,14"
                                 Background="#f5f3f1"
                                 BorderBrush="#ddc0b8"
                                 BorderThickness="1.5">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="CBBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="CBBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                        <Setter TargetName="CBBorder" Property="Background" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Nombre -->
                        <TextBlock Text="Nombre *"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#56423c"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,9"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 MaxLength="100"
                                 Margin="0,0,0,14"
                                 Background="#f5f3f1"
                                 BorderBrush="#ddc0b8"
                                 BorderThickness="1.5">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="NomBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="NomBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                        <Setter TargetName="NomBorder" Property="Background" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Descripción -->
                        <TextBlock Text="Descripción"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#56423c"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,9"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 MaxLength="300"
                                 Margin="0,0,0,14"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="68"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#f5f3f1"
                                 BorderBrush="#ddc0b8"
                                 BorderThickness="1.5">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="DescBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="DescBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                        <Setter TargetName="DescBorder" Property="Background" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Precio -->
                        <TextBlock Text="Precio *"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#56423c"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PrecioBase, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,9"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 Margin="0,0,0,14"
                                 Background="#f5f3f1"
                                 BorderBrush="#ddc0b8"
                                 BorderThickness="1.5">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="PrecBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="PrecBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                        <Setter TargetName="PrecBorder" Property="Background" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Stock actual + mínimo -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stock actual"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#56423c"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,9"
                                         FontFamily="Segoe UI"
                                         FontSize="13"
                                         Background="#f5f3f1"
                                         BorderBrush="#ddc0b8"
                                         BorderThickness="1.5">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border x:Name="SABorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsFocused" Value="True">
                                                                <Setter TargetName="SABorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                                <Setter TargetName="SABorder" Property="Background" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stock mínimo"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#56423c"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,9"
                                         FontFamily="Segoe UI"
                                         FontSize="13"
                                         Background="#f5f3f1"
                                         BorderBrush="#ddc0b8"
                                         BorderThickness="1.5">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border x:Name="SMBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsFocused" Value="True">
                                                                <Setter TargetName="SMBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                                <Setter TargetName="SMBorder" Property="Background" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <!-- Form error message -->
                        <Border Background="#ffdad6"
                                CornerRadius="8"
                                Padding="12,9"
                                Margin="0,4,0,0"
                                Visibility="{Binding MensajeError,
                                    Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding MensajeError}"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="#ba1a1a"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Form buttons -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <!-- Save button -->
                    <Button Command="{Binding GuardarCommand}"
                            Cursor="Hand"
                            Padding="14,11"
                            Margin="0,0,0,8"
                            Style="{StaticResource ButtonPrimary}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE74E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="White"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Guardar"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Cancel button -->
                    <Button Command="{Binding CancelarCommand}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CancelBorder"
                                                    CornerRadius="8"
                                                    Padding="14,11"
                                                    Background="White"
                                                    BorderBrush="#ddc0b8"
                                                    BorderThickness="1.5">
                                                <TextBlock Text="Cancelar"
                                                           FontFamily="Segoe UI"
                                                           FontSize="13"
                                                           Foreground="#56423c"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CancelBorder" Property="Background" Value="#f5f3f1"/>
                                                    <Setter TargetName="CancelBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
