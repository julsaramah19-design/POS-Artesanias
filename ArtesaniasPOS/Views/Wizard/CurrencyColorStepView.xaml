<UserControl x:Class="ArtesaniasPOS.Views.Wizard.CurrencyColorStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="640">

    <Grid Background="#fbf9f7">
        <StackPanel MaxWidth="460" Margin="40,40" HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Encabezado -->
            <TextBlock Text="Moneda principal" FontFamily="Palatino Linotype"
                       FontSize="30" FontWeight="Bold" Foreground="#9d3d1c"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Selecciona la moneda en la que registras tus precios."
                       FontFamily="Segoe UI" FontSize="13" Foreground="#8a726b"
                       Margin="0,0,0,32"/>

            <!-- Selector de moneda -->
            <TextBlock Text="Moneda base *" FontFamily="Segoe UI" FontSize="13"
                       FontWeight="SemiBold" Foreground="#56423c" Margin="0,0,0,8"/>

            <ComboBox ItemsSource="{Binding Monedas}"
                      SelectedItem="{Binding MonedaSeleccionada}"
                      DisplayMemberPath="DisplayText"
                      Padding="14,12" FontSize="14"
                      FontFamily="Segoe UI"
                      Margin="0,0,0,20">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#ddc0b8"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <!-- Tarjeta informativa -->
            <Border Background="White" CornerRadius="12"
                    BorderBrush="#ddc0b8" BorderThickness="1"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="¿Cómo funciona?" FontFamily="Segoe UI"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#1b1c1b" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="#9d3d1c" VerticalAlignment="Center"
                                Margin="0,0,10,0"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#56423c"
                                   TextWrapping="Wrap">
                            Los precios de tus productos se registran en esta moneda.
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="#9d3d1c" VerticalAlignment="Center"
                                Margin="0,0,10,0"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#56423c"
                                   TextWrapping="Wrap">
                            Puedes activar otras monedas después desde Configuración.
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="#9d3d1c" VerticalAlignment="Center"
                                Margin="0,0,10,0"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#56423c"
                                   TextWrapping="Wrap">
                            Las conversiones se aplican automáticamente en ventas.
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
