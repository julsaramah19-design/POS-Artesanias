<UserControl x:Class="ArtesaniasPOS.Views.Wizard.BusinessInfoStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="640">

    <UserControl.Resources>
        <!-- Campo de texto reutilizable -->
        <Style x:Key="WizardField" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ddc0b8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9d3d1c"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#56423c"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#fbf9f7">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="500" Margin="40,32" HorizontalAlignment="Center">

                <!-- Encabezado del paso -->
                <TextBlock Text="Tu negocio" FontFamily="Palatino Linotype"
                           FontSize="30" FontWeight="Bold" Foreground="#9d3d1c"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Esta información aparecerá en tus recibos y facturas."
                           FontFamily="Segoe UI" FontSize="13" Foreground="#8a726b"
                           Margin="0,0,0,28"/>

                <!-- Nombre del negocio -->
                <TextBlock Text="Nombre del negocio *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NombreNegocio, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,11" MaxLength="100"
                         Style="{StaticResource WizardField}"
                         Margin="0,0,0,18"/>

                <!-- NIT -->
                <TextBlock Text="NIT / Cédula" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NIT, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,11" MaxLength="20"
                         Style="{StaticResource WizardField}"
                         Margin="0,0,0,18"/>

                <!-- Teléfono + Email -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,11" MaxLength="15"
                                 Style="{StaticResource WizardField}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,11" MaxLength="100"
                                 Style="{StaticResource WizardField}"/>
                    </StackPanel>
                </Grid>

                <!-- Dirección -->
                <TextBlock Text="Dirección" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,11" MaxLength="200"
                         Style="{StaticResource WizardField}"
                         Margin="0,0,0,18"/>

                <!-- Logo -->
                <TextBlock Text="Logo del negocio" Style="{StaticResource FieldLabel}"/>
                <Border BorderBrush="#ddc0b8" BorderThickness="1.5"
                        CornerRadius="10" Background="White"
                        Padding="20,16" Cursor="Hand"
                        x:Name="LogoDropArea" Margin="0,0,0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <Image x:Name="LogoPreview"
                               MaxHeight="70" MaxWidth="180"
                               Margin="0,0,0,10"
                               Visibility="Collapsed"/>
                        <TextBlock Text="📷  Clic para seleccionar logo"
                                   FontFamily="Segoe UI" FontSize="13"
                                   Foreground="#8a726b"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="PNG o JPG — máximo 2 MB"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#8a726b" Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding SeleccionarLogoCommand}"/>
                    </Border.InputBindings>
                </Border>

                <!-- Nota aclaratoria -->
                <Border Background="#ffdbd0" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#9d3d1c"
                               TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">💡</Run>
                        <Run> Puedes actualizar estos datos más adelante desde Configuración.</Run>
                    </TextBlock>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
