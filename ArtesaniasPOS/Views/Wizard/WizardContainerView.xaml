<UserControl x:Class="ArtesaniasPOS.Views.Wizard.WizardContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wizardVm="clr-namespace:ArtesaniasPOS.Core.ViewModels.Wizard;assembly=ArtesaniasPOS.Core"
             xmlns:wizardViews="clr-namespace:ArtesaniasPOS.Views.Wizard"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type wizardVm:WelcomeStepViewModel}">
            <wizardViews:WelcomeStepView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type wizardVm:BusinessInfoStepViewModel}">
            <wizardViews:BusinessInfoStepView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type wizardVm:CurrencyColorStepViewModel}">
            <wizardViews:CurrencyColorStepView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type wizardVm:AdminUserStepViewModel}">
            <wizardViews:AdminUserStepView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== PANEL IZQUIERDO: branding + pasos ===== -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3a2c26" Offset="0"/>
                    <GradientStop Color="#2b211c" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Row="0" Margin="28,36,28,32">
                    <Border Width="52" Height="52" CornerRadius="14"
                            Background="#9d3d1c" HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <TextBlock Text="A" FontFamily="Palatino Linotype"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Artesanías" FontFamily="Palatino Linotype"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Configuración inicial" FontFamily="Segoe UI"
                               FontSize="12" Foreground="#cbb4a8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Lista de pasos -->
                <StackPanel Grid.Row="1" Margin="20,0,20,0">

                    <!-- Paso 1 -->
                    <Border x:Name="Step1Indicator" CornerRadius="10" Margin="0,0,0,4"
                            Padding="14,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IndicePasoActual}" Value="0">
                                        <Setter Property="Background" Value="#18ffffff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#30ffffff"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IndicePasoActual}" Value="0">
                                                <Setter Property="Background" Value="#9d3d1c"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="1" FontSize="13" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Bienvenida" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="Introducción al sistema" FontSize="11"
                                           Foreground="#cbb4a8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Paso 2 -->
                    <Border CornerRadius="10" Margin="0,0,0,4" Padding="14,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IndicePasoActual}" Value="1">
                                        <Setter Property="Background" Value="#18ffffff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#30ffffff"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IndicePasoActual}" Value="1">
                                                <Setter Property="Background" Value="#9d3d1c"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="2" FontSize="13" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tu negocio" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="Nombre, NIT, contacto" FontSize="11"
                                           Foreground="#cbb4a8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Paso 3 -->
                    <Border CornerRadius="10" Margin="0,0,0,4" Padding="14,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IndicePasoActual}" Value="2">
                                        <Setter Property="Background" Value="#18ffffff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#30ffffff"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IndicePasoActual}" Value="2">
                                                <Setter Property="Background" Value="#9d3d1c"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="3" FontSize="13" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Moneda" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="Moneda principal del sistema" FontSize="11"
                                           Foreground="#cbb4a8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Paso 4 -->
                    <Border CornerRadius="10" Margin="0,0,0,4" Padding="14,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IndicePasoActual}" Value="3">
                                        <Setter Property="Background" Value="#18ffffff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#30ffffff"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IndicePasoActual}" Value="3">
                                                <Setter Property="Background" Value="#9d3d1c"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="4" FontSize="13" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Administrador" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="Usuario y contraseña" FontSize="11"
                                           Foreground="#cbb4a8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer del sidebar -->
                <StackPanel Grid.Row="2" Margin="28,0,28,28">
                    <Border Height="1" Background="#20ffffff" Margin="0,0,0,16"/>
                    <TextBlock Text="Solo toma unos minutos." FontSize="12"
                               Foreground="#cbb4a8" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== PANEL DERECHO: contenido + navegación ===== -->
        <Grid Grid.Column="1" Background="#fbf9f7">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Contenido del paso actual -->
            <ContentControl Grid.Row="0"
                            Content="{Binding PasoActualViewModel}"
                            Margin="0"/>

            <!-- Barra de navegación inferior -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#ddc0b8"
                    BorderThickness="0,1,0,0"
                    Padding="32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botón Anterior -->
                    <Button Grid.Column="0"
                            Content="← Anterior"
                            Command="{Binding AnteriorCommand}"
                            Padding="20,10"
                            FontSize="13"
                            FontFamily="Segoe UI"
                            Cursor="Hand"
                            Visibility="{Binding EsPrimerPaso,
                                Converter={StaticResource BoolToVisibilityInvertedConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#56423c"/>
                                <Setter Property="BorderBrush" Value="#ddc0b8"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#f5f3f1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Mensaje de error centrado -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding MensajeError}"
                               Foreground="#ba1a1a"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <!-- Botón Siguiente / Finalizar -->
                    <Button Grid.Column="2"
                            Content="{Binding TextoBotonSiguiente}"
                            Command="{Binding SiguienteCommand}"
                            Padding="24,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            FontFamily="Segoe UI"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="#9d3d1c"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#bd5532"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
