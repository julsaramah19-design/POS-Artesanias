<UserControl x:Class="ArtesaniasPOS.Views.Wizard.WelcomeStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="640">

    <Grid Background="#fbf9f7">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="440" Margin="40">

            <!-- Icono decorativo -->
            <Border Width="80" Height="80" CornerRadius="20"
                    Background="#9d3d1c" HorizontalAlignment="Center"
                    Margin="0,0,0,28">
                <TextBlock Text="A" FontFamily="Palatino Linotype"
                           FontSize="40" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Título principal -->
            <TextBlock Text="{Binding TituloProducto}"
                       FontFamily="Palatino Linotype"
                       FontSize="38" FontWeight="Bold"
                       Foreground="#9d3d1c"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- Mensaje de bienvenida -->
            <TextBlock Text="{Binding MensajeBienvenida}"
                       FontFamily="Segoe UI"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="#1b1c1b"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- Descripción -->
            <TextBlock Text="{Binding Descripcion}"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Foreground="#56423c"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,36"/>

            <!-- Tarjetas de lo que viene -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10"
                        BorderBrush="#ddc0b8" BorderThickness="1" Padding="14,12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏪" FontSize="22" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Tu negocio" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#56423c" HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="10"
                        BorderBrush="#ddc0b8" BorderThickness="1" Padding="14,12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💰" FontSize="22" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Moneda" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#56423c" HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="White" CornerRadius="10"
                        BorderBrush="#ddc0b8" BorderThickness="1" Padding="14,12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔐" FontSize="22" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Acceso seguro" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#56423c" HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Solo toma unos minutos — presiona Siguiente para comenzar."
                       FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,24,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
