<UserControl x:Class="ArtesaniasPOS.UI.Views.Configuracion.NegocioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#56423c"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Background="White" CornerRadius="14" BorderBrush="#ddc0b8" BorderThickness="1"
            Padding="26,22" VerticalAlignment="Top" MaxWidth="620" HorizontalAlignment="Left"
            Margin="0,0,0,4">
        <Border.Effect>
            <DropShadowEffect Color="#56423c" Opacity="0.07" BlurRadius="16" ShadowDepth="2" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="🏢" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Datos del negocio"
                           FontFamily="Palatino Linotype" FontSize="19" FontWeight="Bold"
                           Foreground="#1b1c1b" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Esta información aparece en los recibos y en el encabezado de la aplicación."
                       FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b"
                       TextWrapping="Wrap" Margin="0,0,0,18"/>

            <TextBlock Text="Nombre del negocio *" Style="{StaticResource Etiqueta}"/>
            <TextBox Style="{StaticResource InputBoxWarm}" Margin="0,0,0,14"
                     Text="{Binding NombreNegocio, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NIT / Cédula" Style="{StaticResource Etiqueta}"/>
                    <TextBox Style="{StaticResource InputBoxWarm}"
                             Text="{Binding NIT, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/>
                    <TextBox Style="{StaticResource InputBoxWarm}"
                             Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/>
            <TextBox Style="{StaticResource InputBoxWarm}" Margin="0,0,0,14"
                     Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Email" Style="{StaticResource Etiqueta}"/>
            <TextBox Style="{StaticResource InputBoxWarm}" Margin="0,0,0,16"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Mensajes -->
            <Border Background="#fdecea" CornerRadius="8" Padding="11,9" Margin="0,0,0,12"
                    Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding MensajeError}" FontFamily="Segoe UI" FontSize="12"
                           Foreground="#ba1a1a" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#e6f0e9" CornerRadius="8" Padding="11,9" Margin="0,0,0,12"
                    Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding MensajeExito}" FontFamily="Segoe UI" FontSize="12"
                           Foreground="#3f6b4f" TextWrapping="Wrap"/>
            </Border>

            <Button Style="{StaticResource ButtonPrimary}" Command="{Binding GuardarCommand}"
                    Padding="22,11" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Guardar cambios" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
      </Border>
    </ScrollViewer>
</UserControl>
