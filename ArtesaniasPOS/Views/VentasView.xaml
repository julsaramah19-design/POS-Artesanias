<UserControl x:Class="ArtesaniasPOS.UI.Views.Ventas.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="700" d:DesignWidth="1000"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#fbf9f7">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER + SEARCH ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Punto de Venta"
                               FontFamily="Palatino Linotype"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1b1c1b"/>
                    <TextBlock Text="Busca productos y gestiona tu venta"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#8a726b"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Search bar row -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search TextBox -->
                <TextBox x:Name="TxtBusqueda"
                         Grid.Column="0"
                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         Foreground="#1b1c1b"
                         Background="#f5f3f1"
                         BorderBrush="#ddc0b8"
                         BorderThickness="1.5"
                         Padding="16,12">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="SBBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"/>
                                                <TextBlock Text="&#x1F50D;  Escanear código o buscar producto..."
                                                           FontFamily="Segoe UI"
                                                           FontSize="14"
                                                           Foreground="#8a726b"
                                                           Margin="18,12,0,0"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent},
                                                               Converter={StaticResource StringToVisibilityInvertedConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="SBBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                <Setter TargetName="SBBorder" Property="Background" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding BuscarCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Search button -->
                <Button Grid.Column="2"
                        Command="{Binding BuscarCommand}"
                        Padding="22,12"
                        Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="White"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Buscar"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ===== PRODUCTS + CART ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Search results card -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#ddc0b8"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#56423c" Opacity="0.06" BlurRadius="12" ShadowDepth="1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Results header -->
                    <Border Grid.Row="0"
                            Background="#f5f3f1"
                            CornerRadius="12,12,0,0"
                            Padding="18,12">
                        <TextBlock Text="Resultados de búsqueda"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#56423c"/>
                    </Border>

                    <!-- Results list -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ResultadosBusqueda}"
                             SelectedItem="{Binding ProductoSeleccionado}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="IB"
                                                    Padding="18,11"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderBrush="#efedec"
                                                    BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="IB" Property="Background" Value="#fbf9f7"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="IB" Property="Background" Value="#fdf0ec"/>
                                                    <Setter TargetName="IB" Property="BorderBrush" Value="#ddc0b8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Color dot avatar -->
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="18"
                                            Background="#fdf0ec"
                                            BorderBrush="#ddc0b8"
                                            BorderThickness="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4E6;"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1b1c1b"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding CodigoBarras}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#8a726b"/>
                                            <TextBlock Text=" · Stock: "
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       Foreground="#8a726b"/>
                                            <TextBlock Text="{Binding StockActual}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       Foreground="#2d7a4f"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="#fdf0ec"
                                            CornerRadius="6"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PrecioBase, StringFormat='${0:N0}'}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#9d3d1c"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- CENTER: Add to cart button -->
            <Button Grid.Column="1"
                    Command="{Binding AgregarAlCarritoCommand}"
                    VerticalAlignment="Center"
                    Margin="12,0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AB"
                                            Width="38" Height="38"
                                            CornerRadius="19"
                                            Background="#9d3d1c">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#9d3d1c" Opacity="0.35" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                                        </Border.Effect>
                                        <TextBlock Text="&#x276F;"
                                                   FontSize="16"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="AB" Property="Background" Value="#bd5532"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="AB" Property="Opacity" Value="0.3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- RIGHT: Cart card -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#ddc0b8"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#56423c" Opacity="0.06" BlurRadius="12" ShadowDepth="1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cart header -->
                    <Border Grid.Row="0"
                            Background="#f5f3f1"
                            CornerRadius="12,12,0,0"
                            Padding="18,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F6D2;"
                                           FontSize="16"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Carrito"
                                           FontFamily="Segoe UI"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#1b1c1b"
                                           VerticalAlignment="Center"/>
                                <!-- Item count badge -->
                                <Border Background="#9d3d1c"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding CantidadItems,
                                            Converter={StaticResource IntToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CantidadItems}"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- Clear cart button -->
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding LimpiarCarritoCommand}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock x:Name="CT"
                                                               Text="Limpiar"
                                                               FontFamily="Segoe UI"
                                                               FontSize="12"
                                                               Foreground="#8a726b"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CT" Property="Foreground" Value="#ba1a1a"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Cart items -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Carrito}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10"
                                        BorderBrush="#efedec"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Name + unit price -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1b1c1b"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PrecioUnitario, StringFormat='${0:N0} c/u'}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       Foreground="#8a726b"/>
                                        </StackPanel>

                                        <!-- Quantity input -->
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="46"
                                                 Padding="4"
                                                 FontFamily="Segoe UI"
                                                 FontSize="13"
                                                 TextAlignment="Center"
                                                 FontWeight="SemiBold"
                                                 Margin="10,0"
                                                 Background="#f5f3f1"
                                                 BorderBrush="#ddc0b8"
                                                 BorderThickness="1">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="6">
                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Discount input -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Width="85">
                                            <TextBlock FontFamily="Segoe UI" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Descuento"/>
                                                        <Setter Property="Foreground" Value="#56423c"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PermiteDescuento}" Value="False">
                                                                <Setter Property="Text" Value="Sin descuento"/>
                                                                <Setter Property="Foreground" Value="#ddc0b8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding DescuentoItem, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DoubleToMoneyConverter}}"
                                                     IsEnabled="{Binding PermiteDescuento}"
                                                     Width="85"
                                                     Padding="4"
                                                     FontFamily="Segoe UI"
                                                     FontSize="12"
                                                     TextAlignment="Center">
                                                <TextBox.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Ingresa el descuento en pesos"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PermiteDescuento}" Value="False">
                                                                            <Setter Property="Text" Value="Productos menores a $60.000 no aplican descuento"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </ToolTip>
                                                </TextBox.ToolTip>
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                                      Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="True">
                                                                <Setter Property="Background" Value="#fff8f0"/>
                                                                <Setter Property="BorderBrush" Value="#ddc0b8"/>
                                                                <Setter Property="Foreground" Value="#9d3d1c"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="#f5f3f1"/>
                                                                <Setter Property="BorderBrush" Value="#efedec"/>
                                                                <Setter Property="Foreground" Value="#ddc0b8"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>

                                        <!-- Subtotal -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Subtotal, StringFormat='${0:N0}'}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#1b1c1b"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <!-- Remove button -->
                                        <Button Grid.Column="4"
                                                Command="{Binding DataContext.QuitarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="RB"
                                                                        Width="26" Height="26"
                                                                        CornerRadius="13"
                                                                        Background="#ffdad6">
                                                                    <TextBlock Text="&#x2715;"
                                                                               FontSize="10"
                                                                               Foreground="#ba1a1a"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="RB" Property="Background" Value="#ba1a1a"/>
                                                                    </Trigger>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                                        </MultiTrigger.Conditions>
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Cart subtotal footer -->
                    <Border Grid.Row="2"
                            Background="#f5f3f1"
                            Padding="18,12"
                            CornerRadius="0,0,12,12"
                            BorderBrush="#efedec"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="Subtotal"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       Foreground="#56423c"/>
                            <TextBlock Text="{Binding SubtotalCarrito, StringFormat='${0:N0}'}"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1b1c1b"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== PAYMENT FOOTER ===== -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#ddc0b8"
                BorderThickness="1"
                Padding="22,16">
            <Border.Effect>
                <DropShadowEffect Color="#56423c" Opacity="0.06" BlurRadius="12" ShadowDepth="1" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: currency + payment method -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Moneda"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#56423c"
                                       Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Monedas}"
                                      SelectedItem="{Binding MonedaSeleccionada}"
                                      DisplayMemberPath="DisplayText"
                                      Padding="10,8"
                                      FontFamily="Segoe UI"
                                      FontSize="12">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Background"      Value="#f5f3f1"/>
                                        <Setter Property="BorderBrush"     Value="#ddc0b8"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Medio de pago"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#56423c"
                                       Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding MediosPago}"
                                      SelectedItem="{Binding MedioPagoSeleccionado}"
                                      DisplayMemberPath="Nombre"
                                      Padding="10,8"
                                      FontFamily="Segoe UI"
                                      FontSize="12">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Background"      Value="#f5f3f1"/>
                                        <Setter Property="BorderBrush"     Value="#ddc0b8"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Column 2: amount paid + change -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="Monto pagado"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#56423c"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding MontoPagado, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Segoe UI"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="#1b1c1b"
                             Background="#f5f3f1"
                             BorderBrush="#ddc0b8"
                             BorderThickness="1.5"
                             Padding="12,10"
                             Margin="0,0,0,10">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="MPBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="MPBorder" Property="BorderBrush" Value="#9d3d1c"/>
                                                    <Setter TargetName="MPBorder" Property="Background" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Change display (warm amber) -->
                    <Border Background="#fff8e8"
                            CornerRadius="8"
                            Padding="14,10"
                            BorderBrush="#f5d78e"
                            BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Cambio:"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       Foreground="#7c5c00"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SimboloMoneda}"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#7c5c00"/>
                                <TextBlock Text="{Binding Cambio, StringFormat='{}{0:N2}'}"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#7c5c00"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Column 3: total + confirm button -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="190">
                    <!-- Total display -->
                    <Border Background="#fdf0ec"
                            CornerRadius="10"
                            Padding="20,14"
                            Margin="0,0,0,10"
                            BorderBrush="#ddc0b8"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#9d3d1c"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SimboloMoneda}"
                                           FontFamily="Segoe UI"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#9d3d1c"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,3,2"/>
                                <TextBlock Text="{Binding TotalEnMoneda, StringFormat='{}{0:N2}'}"
                                           FontFamily="Segoe UI"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#9d3d1c"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Error message -->
                    <Border Margin="0,0,0,5"
                            Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding MensajeError}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#ba1a1a"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>

                    <!-- Success message -->
                    <Border Margin="0,0,0,5"
                            Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding MensajeExito}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#2d7a4f"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Confirm sale button -->
                    <Button Command="{Binding ConfirmarVentaCommand}"
                            Padding="20,13"
                            Style="{StaticResource ButtonPrimary}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE930;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="White"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Confirmar Venta"
                                       FontFamily="Segoe UI"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
