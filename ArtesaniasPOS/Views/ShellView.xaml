<UserControl x:Class="ArtesaniasPOS.UI.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ArtesaniasPOS.Core.ViewModels;assembly=ArtesaniasPOS.Core"
             xmlns:prodVm="clr-namespace:ArtesaniasPOS.Core.ViewModels.Productos;assembly=ArtesaniasPOS.Core"
             xmlns:prodViews="clr-namespace:ArtesaniasPOS.UI.Views.Productos"
             xmlns:ventasVm="clr-namespace:ArtesaniasPOS.Core.ViewModels.Ventas;assembly=ArtesaniasPOS.Core"
             xmlns:ventasViews="clr-namespace:ArtesaniasPOS.UI.Views.Ventas"
             xmlns:reportesVm="clr-namespace:ArtesaniasPOS.Core.ViewModels.Reportes;assembly=ArtesaniasPOS.Core"
             xmlns:reportesViews="clr-namespace:ArtesaniasPOS.UI.Views.Reportes"
             xmlns:configVm="clr-namespace:ArtesaniasPOS.Core.ViewModels.Configuracion;assembly=ArtesaniasPOS.Core"
             xmlns:configViews="clr-namespace:ArtesaniasPOS.UI.Views.Configuracion"
             xmlns:rootViews="clr-namespace:ArtesaniasPOS.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- DataTemplate for placeholder modules -->
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Icono}"
                           FontSize="52"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <TextBlock Text="{Binding Titulo}"
                           FontFamily="Palatino Linotype"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1b1c1b"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Mensaje}"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="#8a726b"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InicioViewModel}">
            <rootViews:InicioView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type prodVm:ProductosViewModel}">
            <prodViews:ProductosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ventasVm:VentasViewModel}">
            <ventasViews:VentasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type reportesVm:ReportesViewModel}">
            <reportesViews:ReportesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type configVm:ConfiguracionContainerViewModel}">
            <configViews:ConfiguracionContainerView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0" x:Name="SidebarBorder">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3a2c26" Offset="0"/>
                    <GradientStop Color="#2b211c" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar header -->
                <StackPanel Grid.Row="0" Margin="24,28,24,20">
                    <TextBlock Text="{Binding NombreNegocio}"
                               FontFamily="Palatino Linotype"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3"/>
                    <TextBlock Text="POS Profesional"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#cbb4a8"/>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="#22ffffff"
                        Margin="16,0"/>

                <!-- Navigation menu -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding MenuSeleccionado}"
                         Background="Transparent"
                         BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         Margin="0,16,8,0">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"         Value="0"/>
                            <Setter Property="Margin"          Value="0,2,0,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                CornerRadius="0,22,22,0"
                                                Padding="20,11"
                                                Cursor="Hand"
                                                Background="Transparent">
                                            <StackPanel x:Name="ItemContent"
                                                        Orientation="Horizontal">
                                                <TextBlock x:Name="IconText"
                                                           Text="{Binding Icono}"
                                                           FontSize="18"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="White"/>
                                                <TextBlock x:Name="TitleText"
                                                           Text="{Binding Titulo}"
                                                           FontFamily="Segoe UI"
                                                           FontSize="14"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#18ffffff"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#9d3d1c"/>
                                                <Setter TargetName="ItemContent" Property="Margin" Value="4,0,0,0"/>
                                                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Content rendered inside ItemContainerStyle -->
                            <ContentPresenter/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Sidebar footer: user info + logout -->
                <Border Grid.Row="2" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- Separator -->
                        <Border Height="1" Background="#22ffffff" Margin="16,0,16,14"/>

                        <!-- User info -->
                        <Grid Margin="18,0,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar circle -->
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="20"
                                    Background="#9d3d1c"
                                    Margin="0,0,12,0">
                                <TextBlock Text="{Binding InicialUsuario}"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreUsuario}"
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="{Binding PerfilNombre}"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="#cbb4a8"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Logout button -->
                        <Button Command="{Binding CerrarSesionCommand}"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Margin="12,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="LogoutBorder"
                                                        CornerRadius="8"
                                                        Padding="14,9"
                                                        Background="#12ffffff">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE8FB;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="13"
                                                                   Foreground="#cbb4a8"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="Cerrar sesión"
                                                                   FontFamily="Segoe UI"
                                                                   FontSize="12"
                                                                   Foreground="#cbb4a8"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="LogoutBorder" Property="Background" Value="#22ffffff"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT ==================== -->
        <Grid Grid.Column="1" Background="#fbf9f7">
            <ContentControl Content="{Binding ContenidoActual}"
                            Margin="0"/>
        </Grid>
    </Grid>
</UserControl>
