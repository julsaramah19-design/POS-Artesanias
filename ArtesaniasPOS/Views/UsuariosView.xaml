<UserControl x:Class="ArtesaniasPOS.UI.Views.Configuracion.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="EtiquetaForm" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#56423c"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Acciones -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Button Command="{Binding NuevoCommand}" Style="{StaticResource ButtonPrimary}"
                        Padding="16,9" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Nuevo usuario" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditarCommand}" Style="{StaticResource ButtonGhost}"
                        Padding="16,9" Margin="0,0,6,0" Content="✏️  Editar"/>
                <Button Command="{Binding ToggleActivoCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="16,9"
                                                Background="#fdecea" BorderBrush="#f3c6bf" BorderThickness="1.5">
                                            <TextBlock x:Name="Txt" Text="🗑️  Desactivar" FontFamily="Segoe UI" FontSize="12"
                                                       Foreground="#ba1a1a"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#fbd9d4"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Seleccionado.Activo}" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="#e6f0e9"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#bcd6c4"/>
                                                <Setter TargetName="Txt" Property="Text" Value="✅  Reactivar"/>
                                                <Setter TargetName="Txt" Property="Foreground" Value="#3f6b4f"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Lista -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#ddc0b8" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Usuarios}" SelectedItem="{Binding Seleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#f3eeeb" BorderThickness="0" Background="Transparent"
                          RowStyle="{StaticResource GridRowWarm}"
                          ColumnHeaderStyle="{StaticResource GridHeaderWarm}"
                          CellStyle="{StaticResource GridCellWarm}"
                          FontFamily="Segoe UI" FontSize="12" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="USUARIO" Binding="{Binding NombreUsuario}" Width="130"/>
                        <DataGridTemplateColumn Header="PERFIL" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#f5f3f1" CornerRadius="8" Padding="9,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding PerfilNombre}" FontFamily="Segoe UI"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#56423c"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ESTADO" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#fdecea"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="True">
                                                        <Setter Property="Background" Value="#e6f0e9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Inactivo"/>
                                                    <Setter Property="Foreground" Value="#ba1a1a"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="True">
                                                            <Setter Property="Text" Value="Activo"/>
                                                            <Setter Property="Foreground" Value="#3f6b4f"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Panel formulario -->
        <Border Grid.Column="1" Width="310" Background="White" CornerRadius="12"
                BorderBrush="#ddc0b8" BorderThickness="1" Padding="22,20" Margin="16,0,0,0"
                Visibility="{Binding FormularioVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="#56423c" Opacity="0.08" BlurRadius="16" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" FontFamily="Palatino Linotype"
                           FontSize="17" FontWeight="Bold" Foreground="#1b1c1b" Margin="0,0,0,16"/>

                <TextBlock Text="Nombre *" Style="{StaticResource EtiquetaForm}"/>
                <TextBox Style="{StaticResource InputBoxWarm}" Margin="0,0,0,12"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Usuario *" Style="{StaticResource EtiquetaForm}"/>
                <TextBox Style="{StaticResource InputBoxWarm}" Margin="0,0,0,12"
                         Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Contraseña" Style="{StaticResource EtiquetaForm}"/>
                <TextBox Style="{StaticResource InputBoxWarm}" Margin="0,0,0,12"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Perfil *" Style="{StaticResource EtiquetaForm}"/>
                <ComboBox Style="{StaticResource ComboWarm}" Margin="0,0,0,15"
                          ItemsSource="{Binding Perfiles}" SelectedItem="{Binding PerfilSeleccionado}"
                          DisplayMemberPath="Nombre"/>

                <Border Background="#fdecea" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding MensajeError}" FontFamily="Segoe UI" FontSize="11.5"
                               Foreground="#ba1a1a" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#e6f0e9" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding MensajeExito, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding MensajeExito}" FontFamily="Segoe UI" FontSize="11.5"
                               Foreground="#3f6b4f"/>
                </Border>

                <Button Command="{Binding GuardarCommand}" Style="{StaticResource ButtonPrimary}"
                        Padding="12,11" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Guardar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelarCommand}" Style="{StaticResource ButtonGhost}"
                        Padding="12,10" Content="Cancelar"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
