<UserControl x:Class="ArtesaniasPOS.UI.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#fbf9f7">

    <UserControl.Resources>
        <!-- Tarjeta base -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#ddc0b8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#56423c" Opacity="0.08"
                                      BlurRadius="18" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Número de paso (círculo) -->
        <Style x:Key="PasoNumero" TargetType="Border">
            <Setter Property="Width"        Value="34"/>
            <Setter Property="Height"       Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background"   Value="#9d3d1c"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="PasoTitulo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1b1c1b"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <Style x:Key="PasoTexto" TargetType="TextBlock">
            <Setter Property="FontFamily"    Value="Segoe UI"/>
            <Setter Property="FontSize"      Value="12.5"/>
            <Setter Property="Foreground"    Value="#56423c"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
            <Setter Property="LineHeight"    Value="18"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="36,30,36,40" MaxWidth="980" HorizontalAlignment="Left">

            <!-- ==================== HERO ==================== -->
            <Border CornerRadius="18" Padding="32,28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9d3d1c" Offset="0"/>
                        <GradientStop Color="#7a2e15" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#f3d9cf">
                            <Run Text="{Binding Saludo, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding NombreUsuario, Mode=OneWay}"/><Run Text=" 👋"/>
                        </TextBlock>
                        <TextBlock FontFamily="Palatino Linotype" FontSize="30" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="Bienvenido a "/><Run Text="{Binding NombreNegocio, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Esta es tu guía rápida: aquí aprenderás cómo funciona todo el sistema, paso a paso."
                                   FontFamily="Segoe UI" FontSize="13.5" Foreground="#f3d9cf"
                                   TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="560"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="🏠" FontSize="64"
                               VerticalAlignment="Center" Margin="20,0,0,0" Opacity="0.9"/>
                </Grid>
            </Border>

            <!-- ==================== PRIMEROS PASOS ==================== -->
            <TextBlock Text="Primeros pasos"
                       FontFamily="Palatino Linotype" FontSize="21" FontWeight="Bold"
                       Foreground="#1b1c1b" Margin="2,28,0,2"/>
            <TextBlock Text="El flujo recomendado para arrancar tu negocio en cuatro pasos."
                       FontFamily="Segoe UI" FontSize="13" Foreground="#8a726b" Margin="2,0,0,16"/>

            <UniformGrid Columns="4">
                <!-- Paso 1 -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource PasoNumero}" HorizontalAlignment="Left">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Configura tu negocio" Style="{StaticResource PasoTitulo}" Margin="0,12,0,2"/>
                        <TextBlock Text="Define nombre, moneda, usuarios, categorías y medios de pago en Configuración."
                                   Style="{StaticResource PasoTexto}"/>
                    </StackPanel>
                </Border>
                <!-- Paso 2 -->
                <Border Style="{StaticResource Tarjeta}" Margin="4,0,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource PasoNumero}" HorizontalAlignment="Left">
                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Carga tus productos" Style="{StaticResource PasoTitulo}" Margin="0,12,0,2"/>
                        <TextBlock Text="Registra cada producto y escanea su código de barras para guardarlo."
                                   Style="{StaticResource PasoTexto}"/>
                    </StackPanel>
                </Border>
                <!-- Paso 3 -->
                <Border Style="{StaticResource Tarjeta}" Margin="4,0,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource PasoNumero}" HorizontalAlignment="Left">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Empieza a vender" Style="{StaticResource PasoTitulo}" Margin="0,12,0,2"/>
                        <TextBlock Text="En Ventas, escanea o busca productos, arma el carrito y cobra."
                                   Style="{StaticResource PasoTexto}"/>
                    </StackPanel>
                </Border>
                <!-- Paso 4 -->
                <Border Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource PasoNumero}" HorizontalAlignment="Left">
                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Revisa tus números" Style="{StaticResource PasoTitulo}" Margin="0,12,0,2"/>
                        <TextBlock Text="Consulta ventas, ingresos y productos más vendidos en Reportes."
                                   Style="{StaticResource PasoTexto}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ==================== DESTAQUE: CÓDIGO DE BARRAS ==================== -->
            <Border CornerRadius="14" Padding="22,18" Margin="0,16,0,0"
                    Background="#f7e8e1" BorderBrush="#e6c3b6" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📷" FontSize="30"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tip: usa tu lector de código de barras"
                                   FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#7a2e15"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="12.5" Foreground="#56423c"
                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Al crear un producto, el cursor queda en el campo de código: solo escanea y el lector lo escribe por ti. ¿No tiene código impreso? Pulsa “Generar”. En Ventas también puedes escanear para agregar productos al carrito al instante."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MÓDULOS ==================== -->
            <TextBlock Text="Conoce cada módulo"
                       FontFamily="Palatino Linotype" FontSize="21" FontWeight="Bold"
                       Foreground="#1b1c1b" Margin="2,30,0,2"/>
            <TextBlock Text="Qué hace cada sección del menú lateral y cómo sacarle provecho."
                       FontFamily="Segoe UI" FontSize="13" Foreground="#8a726b" Margin="2,0,0,16"/>

            <UniformGrid Columns="2">

                <!-- Productos -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📦" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Productos" FontFamily="Segoe UI" FontSize="16"
                                       FontWeight="Bold" Foreground="#1b1c1b" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PasoTexto}"
                                   Text="El catálogo de tu negocio. Aquí creas, editas y das de baja productos."/>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Pulsa “Nuevo producto” y escanea su código de barras."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Asigna categoría, precio y stock (inicial y mínimo)."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Imprime etiquetas con el código para pegar al producto."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Busca por nombre o código y filtra por categoría."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ventas -->
                <Border Style="{StaticResource Tarjeta}" Margin="8,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="💰" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Ventas" FontFamily="Segoe UI" FontSize="16"
                                       FontWeight="Bold" Foreground="#1b1c1b" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PasoTexto}"
                                   Text="El punto de venta para cobrar a tus clientes de forma rápida."/>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Escanea o busca productos para agregarlos al carrito."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Ajusta cantidades y aplica descuentos si los necesitas."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Elige medio de pago y moneda; el sistema calcula el cambio."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Cierra la venta e imprime el recibo."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Reportes (solo admin) -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,12"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📊" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Reportes" FontFamily="Segoe UI" FontSize="16"
                                       FontWeight="Bold" Foreground="#1b1c1b" VerticalAlignment="Center"/>
                            <Border Background="#efedec" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Solo administrador" FontFamily="Segoe UI" FontSize="10"
                                           Foreground="#8a726b"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PasoTexto}"
                                   Text="La salud de tu negocio en números, para tomar mejores decisiones."/>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Consulta ventas e ingresos por rango de fechas."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Identifica tus productos más vendidos."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Vigila el stock bajo para reponer a tiempo."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Configuración (solo admin) -->
                <Border Style="{StaticResource Tarjeta}" Margin="8,0,0,12"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚙️" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Configuración" FontFamily="Segoe UI" FontSize="16"
                                       FontWeight="Bold" Foreground="#1b1c1b" VerticalAlignment="Center"/>
                            <Border Background="#efedec" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Solo administrador" FontFamily="Segoe UI" FontSize="10"
                                           Foreground="#8a726b"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PasoTexto}"
                                   Text="El centro de control donde defines cómo trabaja el sistema."/>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Datos del negocio: nombre, contacto y apariencia."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Categorías y medios de pago disponibles."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Monedas y su tasa de cambio."/>
                            <TextBlock Style="{StaticResource PasoTexto}" Text="• Usuarios y sus perfiles (administrador o vendedor)."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ==================== AYUDA / RESPALDO ==================== -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,4,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="💡" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Consejo importante" FontFamily="Segoe UI" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#1b1c1b" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PasoTexto}"
                               Text="La información se guarda en este equipo. Haz copias de seguridad de tu base de datos con regularidad para no perder tu catálogo ni tus ventas. Como las etiquetas llevan el código impreso, siempre puedes volver a registrar un producto escaneando su código."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Selecciona una opción del menú de la izquierda para comenzar."
                       FontFamily="Segoe UI" FontSize="12" Foreground="#8a726b"
                       HorizontalAlignment="Center" Margin="0,22,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
