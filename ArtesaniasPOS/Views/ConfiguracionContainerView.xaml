<UserControl x:Class="ArtesaniasPOS.UI.Views.Configuracion.ConfiguracionContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:configVm="clr-namespace:ArtesaniasPOS.Core.ViewModels.Configuracion;assembly=ArtesaniasPOS.Core"
             xmlns:configViews="clr-namespace:ArtesaniasPOS.UI.Views.Configuracion"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             Background="#fbf9f7">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type configVm:NegocioViewModel}">
            <configViews:NegocioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type configVm:UsuariosViewModel}">
            <configViews:UsuariosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type configVm:CategoriasViewModel}">
            <configViews:CategoriasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type configVm:MediosPagoViewModel}">
            <configViews:MediosPagoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type configVm:RespaldoViewModel}">
            <configViews:RespaldoView/>
        </DataTemplate>

        <!-- Botón de navegación con estado activo (según SeccionIndex) -->
        <Style x:Key="ConfigNavBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#56423c"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="15,9"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f0e6e0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Configuración"
                       FontFamily="Palatino Linotype" FontSize="28" FontWeight="Bold"
                       Foreground="#1b1c1b"/>
            <TextBlock Text="Administra tu negocio, usuarios y la seguridad de tus datos"
                       FontFamily="Segoe UI" FontSize="13" Foreground="#8a726b" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Navegación -->
        <Border Grid.Row="1" Background="White" CornerRadius="12"
                BorderBrush="#ddc0b8" BorderThickness="1" Padding="8,7" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#56423c" Opacity="0.06" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NavNegocioCommand}" Content="🏢  Negocio">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ConfigNavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeccionIndex}" Value="0">
                                    <Setter Property="Background" Value="#9d3d1c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NavUsuariosCommand}" Content="👥  Usuarios">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ConfigNavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeccionIndex}" Value="1">
                                    <Setter Property="Background" Value="#9d3d1c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NavCategoriasCommand}" Content="🏷️  Categorías">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ConfigNavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeccionIndex}" Value="2">
                                    <Setter Property="Background" Value="#9d3d1c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NavMediosPagoCommand}" Content="💳  Medios de pago">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ConfigNavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeccionIndex}" Value="3">
                                    <Setter Property="Background" Value="#9d3d1c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding NavRespaldoCommand}" Content="🛡️  Respaldo">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ConfigNavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeccionIndex}" Value="4">
                                    <Setter Property="Background" Value="#9d3d1c"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding SeccionActual}"/>
    </Grid>
</UserControl>
